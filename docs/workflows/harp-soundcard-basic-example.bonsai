<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:p1="clr-namespace:Harp.SoundCard;assembly=Harp.SoundCard"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>A</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="p1:CreateMessage">
        <MessageType xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">Write</MessageType>
        <Payload xsi:type="p1:CreatePlaySoundOrFrequencyPayload" xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">
          <p1:PlaySoundOrFrequency>2</p1:PlaySoundOrFrequency>
        </Payload>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:Device">
          <OperationMode xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">Active</OperationMode>
          <OperationLed xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">On</OperationLed>
          <DumpRegisters xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">true</DumpRegisters>
          <VisualIndicators xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">On</VisualIndicators>
          <Heartbeat xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">Disabled</Heartbeat>
          <IgnoreErrors xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">false</IgnoreErrors>
          <PortName xmlns="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp">COM8</PortName>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>